{
  "name": "takitho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de pedidos online de Takitho",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "clean": "rimraf dist coverage .vite playwright-report test-results",
    "icons": "node scripts/brand/build-logos.mjs && node scripts/generate-icons.mjs",
    "svgo": "node scripts/brand/build-logos.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "guard": "node scripts/guard.mjs",
    "secrets": "gitleaks detect --redact --no-banner",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && npm run sync:shared -- --check && npm run guard",
    "check:task": "npm run check:fast && npm run test && npm run deps:check",
    "check:full": "npm run check:task && npm run test:cov && npm run build && npm run size && npm run test:a11y && npm run test:e2e && npm run lighthouse && npm run secrets",
    "test:sql": "vitest run tests/sql",
    "test:fn": "vitest run tests/functions",
    "seed:gen": "node scripts/gen-seed.mjs",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:seed": "supabase db query --linked -f supabase/seed.sql",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:cloud": "supabase gen types typescript --linked > src/types/database.ts",
    "fn:deploy": "supabase functions deploy",
    "secrets:push": "supabase secrets set --env-file supabase/.env.functions"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@supabase/postgrest-js": "2.118.0",
    "@supabase/realtime-js": "2.118.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "jspdf": "4.2.1",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "size-limit": "14.2.0",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0",
    "workbox-window": "7.4.1"
  }
}
