# ─────────────────────────────────────────────────────────────────────────────
# Takitho — variables de entorno
# Copiá este archivo a `.env` (ignorado por git) y completalo. NUNCA subas secrets al repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite). Todo lo que empieza con VITE_ termina en el bundle: solo valores PÚBLICOS. ──
# Supabase → Project Settings → API. Usá la clave "publishable" (sb_publishable_…); la "anon" legacy también sirve.
VITE_SUPABASE_URL=https://<tu-proyecto-dev>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Cloudinary → nombre de la cuenta (es público; aparece en las URLs de las imágenes)
VITE_CLOUDINARY_CLOUD_NAME=tzfvhzgb
# URL pública del sitio (links de seguimiento, QR de mesas). En dev: http://localhost:5173
VITE_SITE_URL=http://localhost:5173
# Cloudflare Turnstile (opcional, anti-bots). Dejalo vacío para desactivarlo.
VITE_TURNSTILE_SITE_KEY=

# ── Edge Functions (SECRETS de Supabase, NO van en .env del front) ──
# Se cargan con:  npx supabase secrets set --env-file supabase/.env.functions
# (copiá este bloque a supabase/.env.functions, que también está ignorado por git)
#
# SITE_URL=https://tu-dominio.com                      # back_urls de Mercado Pago e invitaciones de staff
# ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:5173
# IP_HASH_SALT=<cadena aleatoria larga>                # sal para hashear IPs/teléfonos en el rate limit
#
# MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx                # Mercado Pago → credenciales (de PRUEBA en dev, de PRODUCCIÓN en prod)
# MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx                   # Mercado Pago → Webhooks → "clave secreta"
# MP_ENV=sandbox                                       # sandbox | production
#
# CLOUDINARY_CLOUD_NAME=tzfvhzgb
# CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# TURNSTILE_SECRET=                                    # opcional: si lo definís, create-order exige el token
# RATE_CREATE_IP=5                                     # pedidos por IP cada ventana
# RATE_CREATE_PHONE=3                                  # pedidos por teléfono cada ventana
# RATE_QUOTE_IP=60
# RATE_GET_ORDER_IP=120
# RATE_WINDOW_SECONDS=600
#
# SUPABASE_URL y SUPABASE_SECRET_KEYS / SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase solo: no las definas.
